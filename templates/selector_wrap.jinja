# meson-jll: name={{ name }} version={{ version }}
# Meson requires a source for every [wrap-file], even an overlay-only one,
# so this points at a shared empty archive instead of a real download (see
# generate::EMPTY_TAR_FILENAME). The actual content comes entirely from
# patch_directory below.
[wrap-file]
directory = {{ name }}
source_filename = {{ empty_tar_filename }}
patch_directory = {{ name }}

[provide]
# Makes a plain dependency('{{ name }}') call in a consuming project
# resolve to this subproject automatically, with no fallback wiring.
# The variable is named explicitly instead of using `dependency_names`.
# For `boost`, the `dependency_names` form makes Meson report that the
# subproject did not override the dependency, even though the selector
# overlay calls `meson.override_dependency()`. Naming the variable works
# for every package.
{{ name }} = {{ dependency_variable }}
