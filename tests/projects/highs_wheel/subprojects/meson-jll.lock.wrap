# Meson rejects a wrap file that does not start with a wrap section.
# The sections named meson-jll below hold the lock.
[wrap-file]
directory = meson-jll

[meson-jll]
format = 1

[meson-jll.roots]
HiGHS = *

[meson-jll.package.CompilerSupportLibraries]
version = 1.5.7+0

[meson-jll.package.HiGHS]
version = 1.15.1+0
dependencies = libblastrampoline, CompilerSupportLibraries, Zlib

[meson-jll.package.Zlib]
version = 1.3.2+0

[meson-jll.package.libblastrampoline]
version = 5.15.0+0
